# SQLite (local). For Postgres, switch prisma/schema.prisma provider and set a postgresql URL.
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Discord OAuth App (https://discord.com/developers/applications)
# Redirect URI: http://localhost:3002/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Admin Discord IDs (comma-separated) — only these users can access the vault
ADMIN_DISCORD_IDS=""
NEXT_PUBLIC_ADMIN_DISCORD_IDS=""
