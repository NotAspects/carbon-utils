# PostgreSQL (Supabase, Neon, Vercel Postgres…)
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Discord OAuth App (https://discord.com/developers/applications)
# Redirect URIs:
#   http://localhost:3002/api/auth/callback/discord
#   https://utils.carbon-aio.com/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Admin Discord IDs (comma-separated) — only these users can access the vault
ADMIN_DISCORD_IDS=""
NEXT_PUBLIC_ADMIN_DISCORD_IDS=""
